# Vite exposes only VITE_-prefixed vars to import.meta.env — these names must match
# what main.tsx reads. Bare names (API_URL, STACKONE_API_KEY, ...) are silently ignored.

VITE_STACKONE_API_KEY=
VITE_ORIGIN_OWNER_ID=dummy_customer_id
VITE_ORIGIN_OWNER_NAME=dummy_customer_name
VITE_ORIGIN_USERNAME=dummy_username

# Dev
VITE_API_URL=http://api.stackone-dev.com
VITE_APP_URL=http://app.stackone-dev.com
# Prod
# VITE_API_URL=https://api.stackone.com
# VITE_APP_URL=https://app.stackone.com
# Local
# VITE_API_URL=http://localhost:4000
# VITE_APP_URL=http://localhost:3000

# Optional: pin a specific integration instead of showing the picker
# VITE_INTEGRATION_ID=
